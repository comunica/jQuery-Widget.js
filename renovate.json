{
  "extends": [
    "github>rubensworks/renovate-presets:js"
  ],
  "rangeStrategy": "replace",
  "packageRules": [
    {
      "groupName": "Comunica monorepo packages",
      "rangeStrategy": "bump",
      "automerge": true,
      "minimumReleaseAge": null,
      "schedule": null,
      "prConcurrentLimit": 0,
      "branchConcurrentLimit": 0,
      "matchSourceUrls": [
        "https://github.com/comunica/comunica{/,}**"
      ]
    }
  ]
}
